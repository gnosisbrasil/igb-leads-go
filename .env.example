# Obrigatórias (o boot falha sem elas)
DATABASE_URL=postgres://leads_admin:leads_password@localhost:5432/sistema_leads?sslmode=disable
JWT_SECRET=troque-por-um-segredo-com-ao-menos-32-caracteres

# Servidor / URLs
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# JWT (mesmos nomes do backend Node)
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Captcha (formulários públicos, registro e login)
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=

# Login Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Efí Pix (somente Pix; sem modo simulação)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_BASE64=
EFI_PIX_KEY=
EFI_SANDBOX=true

# WhatsApp não-oficial (meow)
MEOW_URL=https://meow.gnosisbrasil.com
MEOW_API_KEY=
MEOW_SESSION=default

# SMTP (e-mails transacionais e scheduler)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@gnosisbrasil.com
SMTP_FROM_NAME=Sistema de Leads - Gnosis Brasil
